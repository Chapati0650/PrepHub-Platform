# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/src/generated/prisma

# dev-only email outbox (see src/lib/email.ts)
.dev-emails.jsonl

# local dev Postgres data (see scripts/dev-db.mjs)
/.pgdata

# local-disk media storage for question content (see src/lib/content/storage.ts)
/.content-storage

# personal/machine-specific Claude Code settings — .claude/settings.json
# (shared, project-level permissions) is still committed
/.claude/settings.local.json
