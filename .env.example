# Copy to .env.local and fill in. Never commit real values — .gitignore ignores
# every .env* file except this template.

# --- Database ---------------------------------------------------------------
# Local dev: `npm run db:local` starts an embedded Postgres and prints this URL.
# Production uses Neon; that string lives only in the host's env vars.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/prephub

# --- Auth.js ----------------------------------------------------------------
# AUTH_SECRET: generate with `npx auth secret`.
AUTH_SECRET=
# Public origin of this instance — used to build password-reset and Stripe
# return URLs, so it must be the real public domain in production.
NEXTAUTH_URL=http://localhost:3000
# Google OAuth (Google Cloud Console → Credentials → OAuth client).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# --- Email (Resend) ---------------------------------------------------------
# Unset => src/lib/email.ts writes to the .dev-emails.jsonl outbox instead of
# sending. Set it only once the sending domain is verified in Resend.
RESEND_API_KEY=
# Sender for every transactional email. Must be on a domain verified in
# Resend (prephubtp.com). Defaults to PrepHub <no-reply@prephubtp.com>.
EMAIL_FROM=
# Shared secret for the daily cron (netlify/functions/daily-cron.mts calls
# /api/cron/daily with it). Any long random string.
CRON_SECRET=

# --- Media storage ----------------------------------------------------------
# All four R2_* vars set => Cloudflare R2. Any missing => local disk
# (.content-storage/). Local dev needs none of these.
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override for the local-disk backend's root directory.
CONTENT_STORAGE_ROOT=

# --- Landing page (optional) -------------------------------------------------
# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials
# → API key, restricted to "YouTube Data API v3"). Used only to show live view
# counts under the channel videos on the public landing page; unset, the
# videos still render, just without counts. Cached 6h.
YOUTUBE_API_KEY=

# --- Owner CMS extras (optional) --------------------------------------------
# AI-assisted question authoring.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Desmos graphing calculator in the session runner.
NEXT_PUBLIC_DESMOS_API_KEY=
# Google Picker, used by the bulk question upload flow.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# --- Seeding / E2E ----------------------------------------------------------
# Optional. prisma/seed.ts already defaults the Owner email to the address the
# owner_role_single_email_check constraint pins role=OWNER to; no other value
# can hold that role, so override only the password if you want a different one.
OWNER_EMAIL=
OWNER_PASSWORD=
# e2e/helpers.ts signs in as the Owner with these.
OWNER_TEST_EMAIL=
OWNER_TEST_PASSWORD=
