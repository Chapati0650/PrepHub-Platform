generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & Auth (PRD-001) — table shapes required by @auth/prisma-adapter
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  SCHOOL_ADMINISTRATOR
  /// Created by the Owner or a school's Administrator, never by signup
  /// (2026-10-24). Runs classes and assigns homework; has no student
  /// experience of its own and no paid access.
  TEACHER
  STUDENT
}

// Onboarding wizard's "how much time can you dedicate" answer — an input to
// the recommended-pace display only, never to the adaptive ability system.
enum StudyCommitment {
  LIGHT // 10-15 min/day
  MODERATE // 20-30 min/day
  INTENSIVE // 30-60 min/day
  FEW_TIMES_WEEK
  UNSURE
}

// A raw-SQL CHECK constraint (migrations/20260819222439_enforce_single_owner_email)
// enforces role='OWNER' only for the one canonical Owner email at the
// database level — not expressible in Prisma schema syntax, so it won't show
// up here, but don't let a future `prisma migrate dev` drift-reset drop it.
model User {
  id   String @id @default(cuid())
  role Role   @default(STUDENT)

  // PRD-001: only first name is collected, never last name/username/phone
  firstName     String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null when the account only has an OAuth identity
  image         String? // imported from Google, editable; falls back to initials in UI

  grade        Int? // 9-12, required for students; null for OWNER/SCHOOL_ADMINISTRATOR
  ageConfirmed Boolean @default(false)

  // Bumped on password change / "log out all devices" / account deletion to invalidate
  // all outstanding JWT sessions (Credentials provider requires JWT, not DB, sessions)
  tokenVersion Int @default(0)

  targetScore Int? // PRD-010 academic goal, editable any time

  // Post-signup onboarding wizard (grade/target score/study commitment quiz
  // shown before access selection). Null forever for OWNER/SCHOOL_ADMINISTRATOR
  // (never routed through it) and for pre-migration students (backfilled to
  // their createdAt so they're never retroactively forced into it).
  onboardingCompletedAt DateTime?
  studyCommitment       StudyCommitment?

  // PRD-010 §7 — the only notification that's actually a student-facing
  // toggle; "Streak Lost Email" is always-on and not independently disableable,
  // so it has no field here. Actual scheduled delivery (a daily reminder job) is
  // not built — no job scheduler exists in this monolith yet (see CLAUDE.md);
  // this field is real, persisted preference storage, wired up when one exists.
  dailyReminderEnabled Boolean @default(true)

  /// Hides this student from their school's weekly 1v1 Rush leaderboard
  /// (2026-10-24). Shown by default — first name only — because a
  /// leaderboard nobody appears on does nothing, and a student who would
  /// rather not be listed turns it off in Settings. They still see their own
  /// rank; only other students stop seeing them.
  rushLeaderboardHidden Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // PRD-001: deletion is atomic + anonymizing, not row deletion

  accounts           Account[]
  sessions           Session[]
  legalAcceptances   LegalAcceptance[]
  passwordResets     PasswordResetToken[]
  subscription       Subscription?
  studentMembership  StudentMembership?
  adminAssignments   AdministratorAssignment[]
  performedEvents    MembershipHistoryEvent[]  @relation("PerformedBy")
  verificationTokens SchoolVerificationToken[]

  categoryStates          CategoryState[]
  practiceSets            PracticeSet[]
  finalizedAttempts       FinalizedAttempt[]
  diagnosticSession       DiagnosticSession?
  predictionHistory       PredictionHistoryEntry[]
  clubSessions            ClubSession[]
  focusedSessions         FocusedSession[]
  lessonProgress          LessonProgress[]
  collegeAppsProfile      CollegeAppsProfile?
  collegeApplications     CollegeApplication[]
  applicationItems        ApplicationItem[]
  rushChallenges          RushChallenge[]          @relation("RushCreator")
  rushInvites             RushChallenge[]          @relation("RushInvite")
  rushRuns                RushRun[]
  dailyChallengeAttempts  DailyChallengeAttempt[]
  analyticsEvents         AnalyticsEvent[]
  emailSends              EmailSend[]
  announcementsCreated    Announcement[]
  emailVerificationTokens EmailVerificationToken[]
  teacherAssignments      TeacherAssignment[]
  classroomsTaught        Classroom[]              @relation("ClassroomTeacher")
  classroomEnrollments    ClassroomEnrollment[]
  homeworkSessions        HomeworkSession[]

  @@map("users")
}

// Auth.js adapter model — one row per linked provider (google, credentials)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  /// Auth.js looks up a user's linked providers by account.
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String
  tosVersion     String
  privacyVersion String
  acceptedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("legal_acceptances")
}

// ---------------------------------------------------------------------------
// Billing & Subscriptions (PRD-003)
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE // failed payment, inside the 7-day grace period
  CANCELED // canceled but access continues until currentPeriodEnd
  EXPIRED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  plan                 SubscriptionPlan?
  status               SubscriptionStatus @default(EXPIRED)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  gracePeriodEndsAt    DateTime? // PRD-003: 7-day grace period after failed payment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// School Organizations, Contracts & Access (PRD-002, PRD-017)
// ---------------------------------------------------------------------------

enum OrganizationType {
  SCHOOL
  DISTRICT
}

enum OrganizationStatus {
  SETUP
  ACTIVE
  EXPIRED
  SUSPENDED
  ARCHIVED
}

// PRD-009 §7 — one active community goal per school. Districts don't get one:
// the School Community page is scoped to a single school's students.
enum CommunityGoalMetric {
  QUESTIONS_ANSWERED
  STUDY_HOURS
  ADAPTIVE_SESSIONS
}

model Organization {
  id                String             @id @default(cuid())
  organizationType  OrganizationType
  officialName      String
  city              String
  state             String
  schoolYear        String
  contractStartDate DateTime
  contractEndDate   DateTime
  status            OrganizationStatus @default(SETUP)
  internalNotes     String?            @db.Text // Owner-only, never exposed to admins/students

  // PRD-009 §7 — Owner-configured, SCHOOL-type orgs only. Null metric means no
  // active goal is set yet (the School Community page shows no goal section).
  communityGoalMetric    CommunityGoalMetric?
  communityGoalTarget    Int?
  /// What the school wins for reaching the goal (2026-10-24) - set by the
  /// Owner or the school's Administrator, shown to students beside the
  /// progress bar. Null means a goal with no prize.
  communityGoalPrize     String?
  /// The goal counts activity from this moment, reset whenever the goal
  /// changes. Null on goals set before this existed, which keep counting
  /// all-time exactly as they did.
  communityGoalStartsAt  DateTime?
  /// Optional deadline; activity after it doesn't count toward the goal.
  communityGoalEndsAt    DateTime?
  /// First time the goal was seen reached inside its window, kept so the
  /// "reached on" date never moves.
  communityGoalReachedAt DateTime?

  // PRD-011 §9 — Owner-set eligible student population for this school; not
  // editable by the Administrator. Null until the Owner sets it (Registration
  // Percentage is then simply not shown rather than divide-by-null/zero).
  totalEnrollment Int?

  /// Defaults to DOMAIN so existing organizations keep behaving exactly as
  /// they do today; a district switches to ROSTER when it takes control of
  /// eligibility.
  enrollmentMode EnrollmentMode @default(DOMAIN)

  /// The district's own mark, shown to its students inside the product so the
  /// platform reads as something their school provides rather than a stranger
  /// they signed up with. Optional — everything works without it.
  logoMediaId String?
  logo        MediaAsset? @relation("OrganizationLogo", fields: [logoMediaId], references: [id])

  // PRD-002 §15.1: whether this org appears in the student-facing school/district
  // search directory at all — independent of `status` (a directory entry can exist
  // for "known but not partnered" schools without an active contract).
  directoryVisible Boolean @default(true)

  /// Whether this organization's students see a weekly 1v1 Rush leaderboard
  /// (2026-10-24). On by default; the Owner turns it off for a school or a
  /// whole district whose data agreement doesn't allow students to see each
  /// other's names and scores. A school inside a district shows one only if
  /// both allow it.
  rushLeaderboardEnabled Boolean @default(true)

  parentDistrictId String? // null for DISTRICT orgs; set on SCHOOL orgs under a district
  parentDistrict   Organization?  @relation("DistrictSchools", fields: [parentDistrictId], references: [id])
  schools          Organization[] @relation("DistrictSchools")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  domains              OrganizationDomain[]
  rosterEntries        SchoolRosterEntry[]       @relation("RosterOrganization")
  rosterSchoolEntries  SchoolRosterEntry[]       @relation("RosterSchool")
  administratorAssigns AdministratorAssignment[]
  studentMemberships   StudentMembership[]       @relation("MembershipOrganization")
  schoolMemberships    StudentMembership[]       @relation("MembershipSchool")
  verificationTokens   SchoolVerificationToken[]
  historyEventsFrom    MembershipHistoryEvent[]  @relation("PreviousOrganization")
  historyEventsTo      MembershipHistoryEvent[]  @relation("NewOrganization")
  announcements        Announcement[]
  teacherAssignments   TeacherAssignment[]
  classrooms           Classroom[]

  @@map("organizations")
}

// Approved email domains that prove district/school eligibility (PRD-002)
model OrganizationDomain {
  id             String   @id @default(cuid())
  organizationId String
  domain         String   @unique
  isActive       Boolean  @default(true) // PRD-002 §9.3: reject inactive/expired partner domains
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_domains")
}

enum AdministratorScope {
  SCHOOL
  DISTRICT
}

// Join table: an administrator account may be assigned to multiple orgs (PRD-017 §7)
model AdministratorAssignment {
  id             String             @id @default(cuid())
  userId         String
  organizationId String
  scope          AdministratorScope
  createdAt      DateTime           @default(now())
  removedAt      DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("administrator_assignments")
}

enum MembershipStatus {
  ACTIVE
  REMOVED
  GRADUATED
}

enum ActivationMethod {
  SCHOOL_EMAIL_VERIFICATION
  OWNER_OVERRIDE
  // The account's own email was already on a partner district's verified
  // domain AND the provider had verified that email (Google Workspace SSO),
  // so no separate confirmation link was needed. Distinct from
  // SCHOOL_EMAIL_VERIFICATION so the audit trail can answer a district's
  // "how did this student get access?" precisely.
  DOMAIN_MATCH
  // The student's identity was on a roster the district supplied. This is the
  // authoritative path for a paid deployment: the district, not a shared
  // secret or an email suffix, decides who is eligible.
  ROSTER
}

/// How an organization decides who is eligible for its PrepHub access.
/// A pilot can run on DOMAIN alone (no student data changes hands at all);
/// a paid district moves to ROSTER so eligibility is theirs to control, and
/// removing someone from the roster is what ends their access.
enum EnrollmentMode {
  DOMAIN
  ROSTER
  ROSTER_OR_DOMAIN
}

// A student may have at most one active membership at a time (enforced in app logic
// via a partial unique index migration: one ACTIVE row per studentId)
model StudentMembership {
  id                     String           @id @default(cuid())
  studentId              String           @unique // 1:1 today; unique enforces "no 2nd active membership" at the DB level
  organizationId         String // the verified org — a District or a standalone School
  schoolId               String // PRD-017 §3: always resolves to one specific School, even under a District
  verifiedSchoolEmail    String           @unique // PRD-002 §13.4: one school email, one account
  currentGrade           Int
  expectedGraduationYear Int
  status                 MembershipStatus @default(ACTIVE)
  activationMethod       ActivationMethod

  activatedAt  DateTime  @default(now())
  removedAt    DateTime?
  graduatedAt  DateTime?
  restoredAt   DateTime?
  /// When this student was shown the "Premium is free, from your school"
  /// moment (2026-10-24). Null means not yet: the app layout shows it once,
  /// on the first ordinary page after the membership exists. Memberships
  /// that existed before this were backfilled to `activatedAt`, so nobody
  /// who already had access sees it out of the blue.
  celebratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  organization Organization @relation("MembershipOrganization", fields: [organizationId], references: [id])
  school       Organization @relation("MembershipSchool", fields: [schoolId], references: [id])

  historyEvents MembershipHistoryEvent[]

  /// Every school-scoped query is `{ schoolId, status }` or
  /// `{ organizationId, status }` — the admin area, School Community, the
  /// campus report, roster invitations. Both are listed because a district
  /// student's organizationId is the district while schoolId is their campus,
  /// so neither can stand in for the other (PRD-017 §3).
  @@index([schoolId, status])
  @@index([organizationId, status])
  @@map("student_memberships")
}

// PRD-002 §8, §15.4: single-use, expiring school-email ownership proof.
// Membership isn't created until this completes (and, for multi-school districts,
// until the student also picks their specific school — see §10).
model SchoolVerificationToken {
  id                    String    @id @default(cuid())
  studentId             String
  requestedEmail        String
  matchedOrganizationId String
  tokenHash             String    @unique
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  completedAt           DateTime?

  student             User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  matchedOrganization Organization @relation(fields: [matchedOrganizationId], references: [id], onDelete: Cascade)

  @@map("school_verification_tokens")
}

// Audit trail (PRD-017 §21) — not exposed as a UI in V1, but retained
model MembershipHistoryEvent {
  id                     String   @id @default(cuid())
  membershipId           String
  eventType              String
  performedByAccountId   String?
  previousOrganizationId String?
  newOrganizationId      String?
  occurredAt             DateTime @default(now())
  optionalReason         String?

  membership           StudentMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  performedBy          User?             @relation("PerformedBy", fields: [performedByAccountId], references: [id])
  previousOrganization Organization?     @relation("PreviousOrganization", fields: [previousOrganizationId], references: [id])
  newOrganization      Organization?     @relation("NewOrganization", fields: [newOrganizationId], references: [id])

  @@map("membership_history_events")
}

// ---------------------------------------------------------------------------
// Question Content System (PRD-013, PRD-015)
//
// PRD-015 refines PRD-013's model: the individual Question is the primary
// content-management object (not the Question Family). Every content edit to
// a DRAFT/DRAFT_REVISION writes into that Question's *current* QuestionRevision;
// publishing/republishing is what advances currentPublishedRevisionId. Old
// QuestionRevision rows are never deleted — Active Practice Sets (PRD-012/014,
// not yet built) will reference specific revisions so republishing/unpublishing
// never mutates a set a student is already working through.
// ---------------------------------------------------------------------------

enum QuestionCategory {
  READING_COMPREHENSION
  GRAMMAR
  VOCABULARY
  ALGEBRA
  GEOMETRY_TRIGONOMETRY
  ADVANCED_MATH
  PROBLEM_SOLVING_DATA_ANALYSIS
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN_ENDED_NUMERIC
}

enum CalculatorSetting {
  ALLOWED
  NOT_ALLOWED
}

// Shared by Question and QuestionFamily (PRD-015 §4.2)
enum ContentStatus {
  DRAFT
  PUBLISHED
  DRAFT_REVISION
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

// One row per uploaded file, regardless of where it's referenced from.
// Storage is abstracted behind src/lib/content/storage.ts — `storageKey` is an
// opaque key for whatever backend is configured (local disk today).
model MediaAsset {
  id               String      @id @default(cuid())
  kind             MediaKind
  status           MediaStatus @default(UPLOADING)
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  durationSeconds  Int? // video only
  width            Int? // image only
  height           Int? // image only
  failureReason    String? // set when status = FAILED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questionImageFor        QuestionRevision[]     @relation("QuestionRevisionImage")
  standaloneVideoFor      QuestionRevision[]     @relation("QuestionRevisionVideo")
  familySharedVideoFor    QuestionFamily[]       @relation("QuestionFamilyVideo")
  answerChoiceImageFor    QuestionAnswerChoice[] @relation("AnswerChoiceImage")
  explanationStepImageFor ExplanationStep[]      @relation("ExplanationStepImage")
  lessonVideoFor          Lesson[]               @relation("LessonVideo")
  organizationLogos       Organization[]         @relation("OrganizationLogo")

  @@map("media_assets")
}

// PRD-013 §6, PRD-015 §8: optional grouping of up to 3 math-only questions that
// share one video. Family and its member Questions publish/unpublish atomically.
model QuestionFamily {
  id           String             @id @default(cuid())
  status       ContentStatus      @default(DRAFT)
  internalName String? // Owner-facing label only; never shown to students (PRD-015 §5.2)
  category     QuestionCategory
  difficulty   QuestionDifficulty

  sharedVideoId String?
  sharedVideo   MediaAsset? @relation("QuestionFamilyVideo", fields: [sharedVideoId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  questions Question[]

  blueprintSlots BlueprintSlot[]

  @@map("question_families")
}

// The management/aggregate row. category/difficulty/questionType/familyId are
// denormalized here from the current editable revision so the Questions table
// (PRD-015 §4) can filter/sort without joining revision content on every row.
model Question {
  id           String             @id @default(cuid())
  status       ContentStatus      @default(DRAFT)
  questionType QuestionType
  category     QuestionCategory
  difficulty   QuestionDifficulty

  // SHA-256 of the exact source image bytes a bulk-uploaded question was
  // transcribed from (a plain photo, one zip entry, or one rendered PDF
  // page — see bulk-upload.ts). Null for hand-authored questions, which have
  // no source image at all. Lets the bulk-upload pipeline recognize "this
  // exact file was already processed" before spending an AI call on it,
  // rather than after — added following a real incident where a false
  // "Failed" status (since fixed) led to the same PDF pages being
  // re-uploaded repeatedly, producing 125 duplicate questions across 41
  // groups. Not unique: one page image can legitimately produce several
  // Question rows (a page with multiple questions on it), all sharing the
  // same source hash.
  sourceImageHash String?

  familyId String?
  family   QuestionFamily? @relation(fields: [familyId], references: [id])

  currentPublishedRevisionId String?           @unique
  currentPublishedRevision   QuestionRevision? @relation("CurrentPublished", fields: [currentPublishedRevisionId], references: [id])
  currentDraftRevisionId     String?           @unique
  currentDraftRevision       QuestionRevision? @relation("CurrentDraft", fields: [currentDraftRevisionId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  revisions QuestionRevision[] @relation("QuestionRevisions")

  blueprintSlots      BlueprintSlot[]
  diagnosticAttempts  DiagnosticAttempt[]
  finalizedAttempts   FinalizedAttempt[]
  clubSlots           ClubSlot[]
  focusedSlots        FocusedSlot[]
  rushSlots           RushSlot[]
  dailyChallenges     DailyChallenge[]
  assignmentQuestions AssignmentQuestion[]
  homeworkSlots       HomeworkSlot[]

  @@index([sourceImageHash])
  /// The Questions table filters by family, and publishing a family touches
  /// every question in it.
  @@index([familyId])
  @@map("questions")
}

// One immutable-once-published content snapshot. A DRAFT/DRAFT_REVISION question
// edits its currentDraftRevision in place (autosave); republishing copies that
// revision's id into currentPublishedRevisionId and clears currentDraftRevisionId.
model QuestionRevision {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation("QuestionRevisions", fields: [questionId], references: [id], onDelete: Cascade)

  questionText String @db.Text

  // Reading & Writing only. The digital SAT puts the passage in a left pane
  // and the question with its answers in a right one; that is only possible
  // if the two are stored apart. Null means "no passage", which is every
  // maths question and any stem that stands alone, and renders as a single
  // column exactly as before.
  passageText String? @db.Text

  questionImageId String?
  questionImage   MediaAsset? @relation("QuestionRevisionImage", fields: [questionImageId], references: [id])

  calculatorSetting    CalculatorSetting
  suggestedTimeSeconds Int

  // Open-Ended Numeric Response only (PRD-013 §15)
  acceptedAnswers String[] @default([])

  writtenExplanation String? @db.Text

  // Standalone questions only — family questions use QuestionFamily.sharedVideo
  standaloneVideoId String?
  standaloneVideo   MediaAsset? @relation("QuestionRevisionVideo", fields: [standaloneVideoId], references: [id])

  // Set when this exact revision has been opened in Student Preview; cleared by
  // any content edit (PRD-015 §5.5). Publishing requires this to be non-null.
  previewCompletedAt DateTime?

  // Bulk-upload AI review gate: set on the initial revision created by the
  // bulk-upload pipeline (src/lib/content/bulk-upload.ts). aiReviewedAt stays
  // null — blocking publish (see getPublishIssues) — until the Owner
  // explicitly confirms the AI-transcribed content and AI-suggested answer
  // via "Mark as Reviewed." aiAnswerReasoning is shown to the Owner during
  // review only, never to students.
  aiGenerated       Boolean   @default(false)
  aiReviewedAt      DateTime?
  aiAnswerReasoning String?   @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  answerChoices    QuestionAnswerChoice[]
  explanationSteps ExplanationStep[]

  currentPublishedFor Question? @relation("CurrentPublished")
  currentDraftFor     Question? @relation("CurrentDraft")

  blueprintSlots      BlueprintSlot[]
  diagnosticAttempts  DiagnosticAttempt[]
  clubSlots           ClubSlot[]
  focusedSlots        FocusedSlot[]
  rushSlots           RushSlot[]
  dailyChallenges     DailyChallenge[]
  assignmentQuestions AssignmentQuestion[]
  homeworkSlots       HomeworkSlot[]

  /// The editor lists a question's revision history.
  @@index([questionId])
  @@map("question_revisions")
}

// Multiple Choice only — exactly 4 per revision, exactly one isCorrect (PRD-013 §14)
model QuestionAnswerChoice {
  id         String           @id @default(cuid())
  revisionId String
  revision   QuestionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  order     Int // 0-3, display order
  text      String  @db.Text
  isCorrect Boolean @default(false)

  // Null for the correct choice (never shown there) and for wrong choices
  // that haven't been generated/written yet — the student-facing renderer
  // just omits the note in that case, same as any other optional content
  // field. Populated by generateDistractorExplanations (AI, reviewable by
  // the Owner) or typed manually — a short, specific note on the likely
  // mistake behind picking this particular wrong answer (a procedural slip,
  // a classic distractor, or "unrelated to the correct method" for a guess).
  distractorExplanation String? @db.Text

  imageId String?
  image   MediaAsset? @relation("AnswerChoiceImage", fields: [imageId], references: [id])

  @@unique([revisionId, order])
  @@map("question_answer_choices")
}

// A richer alternative to the plain-text writtenExplanation field: an ordered
// walkthrough where any step can carry its own image (a generated diagram,
// graph, or number line, or a manually uploaded one) — the Brilliant.org-style
// step-by-step explanation. writtenExplanation is untouched and still used as
// a fallback for older/simpler content; where both exist, steps take priority
// in the student-facing renderer. Deleting/recreating the whole set on every
// save (rather than diffing) mirrors how QuestionAnswerChoice's fixed 4-slot
// array is already patched wholesale in this editor.
model ExplanationStep {
  id         String           @id @default(cuid())
  revisionId String
  revision   QuestionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  order Int // 0-based, display order
  text  String @db.Text

  imageId String?
  image   MediaAsset? @relation("ExplanationStepImage", fields: [imageId], references: [id])

  @@unique([revisionId, order])
  @@map("explanation_steps")
}

// ---------------------------------------------------------------------------
// Diagnostic, Adaptive Practice & Predicted Score (PRD-012, PRD-014, PRD-016)
//
// BlueprintSlot/DiagnosticAttempt reference the exact QuestionRevision shown
// to the student, not just the Question — revisions are immutable once
// published (PRD-013/015) and never deleted, so a student's already-started
// set/diagnostic keeps its exact content even if the Owner later edits,
// republishes, or unpublishes the question (PRD-005 §17, PRD-014 §17).
// ---------------------------------------------------------------------------

// One row per student per category, created only after diagnostic completion
// (PRD-014 §4). ability/initialAbility are plain floats, not Decimal — the
// update formula (10^x powers, division) is inherently floating-point, and
// nothing here is money-like exact-arithmetic.
model CategoryState {
  id        String           @id @default(cuid())
  studentId String
  category  QuestionCategory

  ability                               Float
  initialAbility                        Float
  adaptiveQuestionsAnswered             Int       @default(0)
  consecutiveSetsWithoutExtraAllocation Int       @default(0)
  lastAbilityUpdatedAt                  DateTime?

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, category])
  @@map("category_states")
}

enum PracticeSetStatus {
  ACTIVE
  COMPLETED
}

// PRD-014 §13: a student may have at most one ACTIVE set — enforced in
// application logic (generatePracticeSet checks before creating a new one),
// matching this codebase's established pattern (see StudentMembership) of
// enforcing single-active-row invariants in code, not a DB partial index.
model PracticeSet {
  id              String            @id @default(cuid())
  studentId       String
  setNumber       Int // sequential per student; the diagnostic is not Set 1 (PRD-005 §9)
  status          PracticeSetStatus @default(ACTIVE)
  engineVersion   String
  randomSeed      String
  currentPosition Int               @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  student           User                         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  categorySnapshots CategoryGenerationSnapshot[]
  slots             BlueprintSlot[]
  finalizedAttempts FinalizedAttempt[]
  predictionEntries PredictionHistoryEntry[]

  @@unique([studentId, setNumber])
  @@map("practice_sets")
}

// One row per category per set — the audit trail behind category allocation
// (PRD-014 §14 "Category Generation Snapshot").
model CategoryGenerationSnapshot {
  id            String           @id @default(cuid())
  practiceSetId String
  category      QuestionCategory

  abilityAtGeneration Float
  weaknessScore       Float
  recentStruggleScore Float
  focusRecencyScore   Float
  priorityScore       Float
  guaranteedSlotCount Int
  additionalSlotCount Int

  practiceSet PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)

  @@unique([practiceSetId, category])
  @@map("category_generation_snapshots")
}

// One row per question position in a generated set (PRD-014 §10). resolved*
// starts equal to planned* and only changes through content fallback (§12).
model BlueprintSlot {
  id            String @id @default(cuid())
  practiceSetId String
  position      Int

  plannedCategory    QuestionCategory
  plannedDifficulty  QuestionDifficulty
  resolvedCategory   QuestionCategory
  resolvedDifficulty QuestionDifficulty

  questionId         String
  questionRevisionId String
  questionFamilyId   String?

  // Draft state prior to finalization (PRD-006 §11/§18) — not itself scored.
  draftAnswer String?
  skipped     Boolean @default(false)

  practiceSet      PracticeSet      @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id])
  questionRevision QuestionRevision @relation(fields: [questionRevisionId], references: [id])
  family           QuestionFamily?  @relation(fields: [questionFamilyId], references: [id])

  finalizedAttempt FinalizedAttempt?

  @@unique([practiceSetId, position])
  @@map("blueprint_slots")
}

// PRD-014 §14/§16 "Finalized Attempt" — created exactly once per slot, when
// the student's answer is finalized. Finalizing is atomic and idempotent: a
// retried request must see blueprintSlot.finalizedAttempt already exists and
// return it rather than reapplying the Ability Score update (§16 pseudocode).
model FinalizedAttempt {
  id              String @id @default(cuid())
  studentId       String
  practiceSetId   String
  blueprintSlotId String @unique
  questionId      String

  category   QuestionCategory
  difficulty QuestionDifficulty

  answer    String?
  isBlank   Boolean
  isCorrect Boolean

  expectedProbability  Float
  kValue               Float
  abilityBefore        Float
  rawAbilityChange     Float
  appliedAbilityChange Float
  abilityAfter         Float

  finalizedAt   DateTime @default(now())
  engineVersion String

  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practiceSet   PracticeSet   @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  blueprintSlot BlueprintSlot @relation(fields: [blueprintSlotId], references: [id], onDelete: Cascade)
  question      Question      @relation(fields: [questionId], references: [id])

  /// Every per-student read goes through this: the dashboard, Progress, the
  /// Student Directory and every campus aggregate filter on `studentId`, and
  /// the streak/today/this-week figures add a `finalizedAt` range on top. With
  /// no index this table was scanned end to end for each of them, and it is
  /// the fastest-growing table in the product — one row per question answered,
  /// per student, forever.
  @@index([studentId, finalizedAt])
  /// Session Review loads one set's attempts.
  @@index([practiceSetId])
  @@map("finalized_attempts")
}

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
}

// One per student, ever — PRD-012 §25: no traditional retake. A row is only
// created once the student actually begins (Not Started = no row, derived).
/// Which version of the Diagnostic a session was run as.
///
/// FULL_21 is the original instrument: all 21 questions, every student, in the
/// order they were generated. STAGED (2026-10-24) is fourteen core questions —
/// one Easy and one Medium per category — and then a bonus round holding the
/// Hard question only for categories where the student got the Medium right.
///
/// Recorded per session because the two produce slightly different starting
/// scores for the same student (see src/lib/diagnostic/sequence.ts), and a
/// district's gain reporting must never compare a cohort measured one way with
/// a cohort measured the other without knowing it.
enum DiagnosticFormat {
  FULL_21
  STAGED
}

model DiagnosticSession {
  id              String           @id @default(cuid())
  studentId       String           @unique
  status          DiagnosticStatus @default(IN_PROGRESS)
  currentPosition Int              @default(0)

  /// Defaults to FULL_21 at the database level on purpose, and new code always
  /// writes STAGED explicitly. The migration that adds this column lands before
  /// the code that uses it, and in that window the old code is still creating
  /// sessions in the old order; a STAGED default would mislabel them. An
  /// IN_PROGRESS FULL_21 session is converted to STAGED the next time its
  /// student opens it (convertLegacySession), so only finished ones keep the
  /// old label — which is then simply the truth about which test they took.
  format DiagnosticFormat @default(FULL_21)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  student  User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempts DiagnosticAttempt[]

  @@map("diagnostic_sessions")
}

// 21 rows per session: exactly one Easy, one Medium, one Hard per category
// (PRD-012 §11). Diagnostic answers never feed adaptiveQuestionsAnswered or
// Recent Struggle (PRD-014 §5) — they use a wholly separate scoring path.
model DiagnosticAttempt {
  id                  String @id @default(cuid())
  diagnosticSessionId String
  position            Int

  category   QuestionCategory
  difficulty QuestionDifficulty

  questionId         String
  questionRevisionId String

  draftAnswer String?
  skipped     Boolean @default(false)

  answer      String?
  isBlank     Boolean?
  isCorrect   Boolean?
  submittedAt DateTime?

  /// Set on a Hard question that is never shown, because the student missed
  /// that category's Medium (STAGED format only). It scores exactly as a wrong
  /// answer — `isCorrect` stays null, and every scorer reads `!!isCorrect` —
  /// so the scoring tables needed no change. A Hard question that has already
  /// been answered is never waived.
  waivedAt DateTime?

  diagnosticSession DiagnosticSession @relation(fields: [diagnosticSessionId], references: [id], onDelete: Cascade)
  question          Question          @relation(fields: [questionId], references: [id])
  questionRevision  QuestionRevision  @relation(fields: [questionRevisionId], references: [id])

  @@unique([diagnosticSessionId, position])
  @@map("diagnostic_attempts")
}

enum PredictionSourceType {
  DIAGNOSTIC
  ADAPTIVE_SET
}

// PRD-016 §10 "Prediction History" — one immutable entry after the diagnostic
// and after every completed set. Never recalculated after config changes.
model PredictionHistoryEntry {
  id          String               @id @default(cuid())
  studentId   String
  sourceType  PredictionSourceType
  sourceSetId String?

  readingWritingAbility      Float?
  mathAbility                Float?
  overallAbility             Float?
  internalDiagnosticEstimate Float?

  displayedRangeIndex    Int
  displayedRangeMinimum  Int
  displayedRangeMaximum  Int
  representativeMidpoint Int
  approximateImprovement Int
  withinRangeProgress    Float

  scoringEngineVersion String
  createdAt            DateTime @default(now())

  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  practiceSet PracticeSet? @relation(fields: [sourceSetId], references: [id])

  /// Had no index at all beyond the primary key, and is read by student on
  /// the dashboard, Progress, the campus impact report and the school
  /// aggregate — all of which want it in `createdAt` order, which this also
  /// serves.
  @@index([studentId, createdAt])
  @@map("prediction_history_entries")
}

// ---------------------------------------------------------------------------
// School Administrator (PRD-011)
// ---------------------------------------------------------------------------

// PRD-011 §16-§18 — one per school, created by an Administrator. `removedAt`
// is a soft delete (admin "Remove an active announcement") so it can still
// surface under "View previous announcements" rather than disappearing
// entirely; `expiresAt` is a separate, student-facing natural expiration.
// Delivered by email exactly once, at publish time (see the createdAt-gated
// idempotency note on `publishAnnouncement`) — there is no send-again action.
model Announcement {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  message        String    @db.Text
  publishedAt    DateTime  @default(now())
  expiresAt      DateTime?
  removedAt      DateTime?

  createdByUserId String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  /// Read on every dashboard render for a student with a school membership.
  @@index([organizationId, publishedAt])
  @@map("announcements")
}

// ---------------------------------------------------------------------------
// 800 Club — hard-question sessions, deliberately outside the adaptive engine.
//
// These are NOT PracticeSets. The app enforces "at most one ACTIVE PracticeSet
// per student" and /practice finds the active set by status alone, so a club
// session stored there would hijack the real practice loop; and PRD-014's
// ability update / PRD-016's prediction must never see a hard-only sample.
// Keeping club sessions in their own tables makes both true by construction:
// nothing in src/lib/adaptive reads or writes these rows. A ClubSlot pins a
// questionRevisionId for the same content-stability reason BlueprintSlot does.
// The section's question pool is "published HARD questions in the section's
// categories" — no separate tag, by Owner decision (2026-09-19).
// ---------------------------------------------------------------------------

enum ClubSection {
  READING_WRITING
  MATH
}

enum ClubSessionStatus {
  ACTIVE
  COMPLETED
}

model ClubSession {
  id              String            @id @default(cuid())
  studentId       String
  section         ClubSection
  status          ClubSessionStatus @default(ACTIVE)
  randomSeed      String
  currentPosition Int               @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  student User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slots   ClubSlot[]

  @@index([studentId, status])
  @@map("club_sessions")
}

model ClubSlot {
  id                 String  @id @default(cuid())
  sessionId          String
  position           Int
  questionId         String
  questionRevisionId String
  draftAnswer        String?
  skipped            Boolean @default(false)

  // The attempt lives inline: one slot is answered at most once, so a
  // separate attempt table would only add a join. finalizedAt IS NULL is the
  // idempotency check, taken inside a transaction.
  answer      String?
  isCorrect   Boolean?
  finalizedAt DateTime?

  session          ClubSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id])
  questionRevision QuestionRevision @relation(fields: [questionRevisionId], references: [id])

  @@unique([sessionId, position])
  @@index([questionId])
  @@map("club_slots")
}

// ---------------------------------------------------------------------------
// The Curriculum — the Owner's video course. Modules hold ordered lessons; a
// lesson's video is either a YouTube video (by id) or an uploaded MediaAsset
// through the same pipeline question explanation videos use. Students see
// only published lessons; playback of a non-free lesson needs paid access
// (decided by hasPaidAccess, never here). LessonProgress is one row per
// (student, lesson) — completion is a fact recorded once, not a counter.
// ---------------------------------------------------------------------------

enum LessonVideoSource {
  YOUTUBE
  UPLOAD
}

model CurriculumModule {
  id       String @id @default(cuid())
  title    String
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@map("curriculum_modules")
}

model Lesson {
  id              String            @id @default(cuid())
  moduleId        String
  title           String
  description     String            @default("")
  position        Int
  videoSource     LessonVideoSource @default(YOUTUBE)
  youtubeVideoId  String?
  mediaAssetId    String?
  durationSeconds Int?
  isFree          Boolean           @default(false)
  publishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module     CurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset?      @relation("LessonVideo", fields: [mediaAssetId], references: [id])
  progress   LessonProgress[]

  @@index([moduleId, position])
  @@map("lessons")
}

model LessonProgress {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  completedAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  /// Counting who has watched a lesson.
  @@index([lessonId])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------
// College Apps — the application tracker (2026-09-19, modeled on oneprep.xyz's
// College tab; Premium, included in the single rate).
//
// The college directory itself is NOT a table: ~1,900 bachelor's-granting
// institutions from the U.S. Dept. of Education's College Scorecard ship as
// a committed JSON (src/lib/colleges/data/colleges.json), searched in memory,
// refreshed yearly by scripts/pull-colleges.mjs. Rows here reference a
// Scorecard id and denormalize the name so a student's list survives a
// directory refresh that drops or renames a school.
//
// One checklist table (ApplicationItem) holds everything a student can tick
// off: essay prompts, recommendation letters, score sends, fees. Items with a
// null applicationId are student-level — the Common App personal statement
// and UC PIQs are written once and reused, and FAFSA/CSS Profile aren't tied
// to one college. Prompts are COPIED into a student's list when they add a
// college (from the platform constants in code and the Owner's curated
// CollegeSupplement rows), never referenced: a student's checklist must not
// change under them when the Owner edits next year's supplements, and each
// student's "done" is their own.
// ---------------------------------------------------------------------------

enum ApplicationPlatform {
  COMMON_APP
  UC_APPLICATION
  COALITION
  APPLY_TEXAS
  OTHER
}

enum ApplicationPlan {
  EARLY_DECISION
  EARLY_DECISION_2
  EARLY_ACTION
  RESTRICTIVE_EARLY_ACTION
  REGULAR_DECISION
  ROLLING
}

enum ApplicationStatus {
  RESEARCHING
  APPLYING
  SUBMITTED
  ACCEPTED
  WAITLISTED
  DENIED
  WITHDRAWN
}

enum ApplicationItemKind {
  PROMPT
  RECOMMENDATION
  TEST_SCORES
  FEE
  FINANCIAL_AID
  OTHER
}

enum ApplicationItemSource {
  PLATFORM // Common App / UC / Coalition prompts from code constants
  CURATED // the Owner's CollegeSupplement rows for that college + cycle
  STUDENT // added by the student, by hand or from AI-parsed pasted text
}

// Set by the College Apps onboarding wizard. The grade decides the whole
// view (a freshman gets a "this year" checklist, a senior gets the
// deadline-first tracker); the platforms decide which shared essays are
// seeded as student-level items.
model CollegeAppsProfile {
  id          String                @id @default(cuid())
  userId      String                @unique
  grade       Int // 9-12, the current school year
  platforms   ApplicationPlatform[]
  onboardedAt DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("college_apps_profiles")
}

model CollegeApplication {
  id          String               @id @default(cuid())
  studentId   String
  collegeId   Int // College Scorecard institution id
  collegeName String
  platform    ApplicationPlatform?
  plan        ApplicationPlan?
  deadline    DateTime? // date only; stored at UTC midnight
  status      ApplicationStatus    @default(RESEARCHING)
  notes       String               @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items   ApplicationItem[]

  @@unique([studentId, collegeId])
  @@index([studentId, deadline])
  @@map("college_applications")
}

model ApplicationItem {
  id            String                @id @default(cuid())
  studentId     String
  applicationId String? // null = student-level (shared essays, FAFSA, CSS Profile)
  kind          ApplicationItemKind
  source        ApplicationItemSource
  title         String
  detail        String                @default("") // the prompt text, the recommender's name, etc.
  wordLimit     Int?
  position      Int
  doneAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student     User                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application CollegeApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([studentId, applicationId, position])
  /// The checklist loads one application's items.
  @@index([applicationId])
  @@map("application_items")
}

// The Owner's yearly curation: one row per supplemental prompt per college
// per admissions cycle (the cycle is the year applications are due, so the
// 2026-27 season is cycle 2027). Entered each August from Common App; copied
// into a student's checklist when they add the college.
model CollegeSupplement {
  id         String @id @default(cuid())
  collegeId  Int
  cycle      Int
  title      String
  promptText String
  wordLimit  Int?
  position   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([collegeId, cycle, position])
  @@map("college_supplements")
}

// ---------------------------------------------------------------------------
// 1v1 Rush — timed 10-question runs, played solo, against a friend (link or
// code), or against a randomly matched student. Asynchronous by design
// (2026-09-20): two players never need to be online together, so it works
// with five users and needs no real-time service. Like the 800 Club, these
// tables are outside the adaptive engine — a speed-pressured answer must
// never feed the ability model or the Predicted Score.
//
// A RushSet is the ten questions (seeded, pinned to revisions). A
// RushChallenge is a set plus its participants; every run of the same
// challenge sees the identical questions, which is what makes a comparison
// fair. RANDOM challenges are matched by joining an existing one that has
// exactly one finished run by someone else; if none exists, the player's own
// run opens a new one for the next person. A RushAnswer row is created when
// the question is *served* (servedAt), so elapsed time is measured on the
// server, not trusted from the client.
// ---------------------------------------------------------------------------

enum RushDifficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

enum RushMode {
  SOLO
  FRIEND
  RANDOM
}

enum RushRunStatus {
  ACTIVE
  COMPLETED
}

// Live rooms only (RushChallenge.live). WAITING: creator alone in the
// lobby. COUNTDOWN: both in, liveStartsAt set. PLAYING: livePosition is the
// question both players are on, livePositionStartedAt its shared clock.
// FINISHED: every run COMPLETED.
enum RushLiveStatus {
  WAITING
  COUNTDOWN
  PLAYING
  FINISHED
}

model RushSet {
  id         String         @id @default(cuid())
  section    ClubSection
  difficulty RushDifficulty
  randomSeed String
  createdAt  DateTime       @default(now())

  slots      RushSlot[]
  challenges RushChallenge[]

  @@map("rush_sets")
}

model RushSlot {
  id                 String @id @default(cuid())
  setId              String
  position           Int
  questionId         String
  questionRevisionId String

  set              RushSet          @relation(fields: [setId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id])
  questionRevision QuestionRevision @relation(fields: [questionRevisionId], references: [id])

  @@unique([setId, position])
  @@map("rush_slots")
}

model RushChallenge {
  id        String   @id @default(cuid())
  setId     String
  mode      RushMode
  code      String   @unique // 6 chars, unambiguous alphabet; the join link carries it
  creatorId String
  createdAt DateTime @default(now())

  // Live head-to-head (Owner decision, 2026-09-20: "both online at the same
  // time is more intense"). Both players sit on one server-side clock:
  // livePositionStartedAt is when the current question opened for both,
  // and tickLive advances it when both have answered or the limit passes.
  // No WebSockets on this host — clients poll getLiveState once a second.
  /// Which points rules every run in this challenge is scored by. 1 is speed
  /// and correctness only; 2 (2026-10-24) adds the answer-streak bonus. Stored
  /// per challenge rather than read from the current config, because a friend
  /// challenge is two runs played days apart: the second player must be
  /// scored by the rules the first one was, or a streak bonus the first player
  /// never had a chance at decides the result. Defaults to 1 at the database
  /// level so a challenge created by older code during a deploy is labelled
  /// truthfully; new code writes the current version explicitly.
  scoringVersion Int @default(1)

  live                  Boolean         @default(false)
  liveStatus            RushLiveStatus?
  liveStartsAt          DateTime?
  livePosition          Int             @default(0)
  livePositionStartedAt DateTime?

  set     RushSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  creator User      @relation("RushCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  runs    RushRun[]

  /// The match this one is a rematch of (2026-10-24). Unique, so a match can
  /// be rematched exactly once: two players pressing Rematch in the same
  /// instant both land in the same new match — the second insert hits this
  /// constraint and joins the first — instead of each opening a room and
  /// waiting for the other. A rematch of a rematch chains naturally.
  rematchOfId String?        @unique
  rematchOf   RushChallenge? @relation("Rematch", fields: [rematchOfId], references: [id], onDelete: SetNull)
  rematch     RushChallenge? @relation("Rematch")

  /// The one student a rematch is for. A rematch room is theirs to join and
  /// nobody else's, which is also why a rematch lobby shows no share code.
  invitedStudentId String?
  invitedStudent   User?   @relation("RushInvite", fields: [invitedStudentId], references: [id], onDelete: Cascade)

  @@index([mode, createdAt])
  @@index([invitedStudentId])
  @@index([live, liveStatus])
  @@map("rush_challenges")
}

model RushRun {
  id           String        @id @default(cuid())
  challengeId  String
  studentId    String
  status       RushRunStatus @default(ACTIVE)
  position     Int           @default(0) // next question to serve
  score        Int           @default(0)
  correctCount Int           @default(0)
  totalMs      Int           @default(0)
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  lastSeenAt   DateTime      @default(now()) // presence for live rooms: bumped on every poll

  challenge RushChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers   RushAnswer[]

  @@unique([challengeId, studentId])
  @@index([studentId, status])
  @@map("rush_runs")
}

model RushAnswer {
  id         String    @id @default(cuid())
  runId      String
  position   Int
  servedAt   DateTime  @default(now())
  answeredAt DateTime?
  answer     String? // null = timed out / blank
  isCorrect  Boolean?
  elapsedMs  Int?
  points     Int?

  run RushRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@map("rush_answers")
}

// ---------------------------------------------------------------------------
// Daily Challenge — one hard question a day, free for every account (Owner
// decision, 2026-09-21: the free tier needed something to come back for;
// 5 of 105 students had returned after day one). The day's question is
// chosen once (first request of the UTC day, seeded by the date) and
// pinned here so everyone gets the same one and the review page can
// always show it. Attempts are outside the adaptive engine, like the 800
// Club and Rush: a single daily answer must never move an ability score.
// ---------------------------------------------------------------------------

model DailyChallenge {
  id                 String   @id @default(cuid())
  day                String   @unique // YYYY-MM-DD, UTC
  questionId         String
  questionRevisionId String
  createdAt          DateTime @default(now())

  question         Question                @relation(fields: [questionId], references: [id])
  questionRevision QuestionRevision        @relation(fields: [questionRevisionId], references: [id])
  attempts         DailyChallengeAttempt[]

  @@map("daily_challenges")
}

model DailyChallengeAttempt {
  id          String   @id @default(cuid())
  challengeId String
  studentId   String
  answer      String
  isCorrect   Boolean
  answeredAt  DateTime @default(now())

  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([challengeId, studentId])
  @@index([studentId, answeredAt])
  @@map("daily_challenge_attempts")
}

// ---------------------------------------------------------------------------
// First-party funnel events (2026-09-21). No third-party analytics: the
// funnel is six server-side events written where the thing actually
// happens (signup, diagnostic started/completed, paywall viewed, checkout
// started, subscribed) plus a page-view beacon for the public pages, read
// back by the Owner's Funnel page. Server-side, so ad blockers don't hide
// the numbers that matter; a beacon only for the pages a session can't
// identify. `userId` is nullable and cascades on delete — account deletion
// is anonymizing (PRD-001), and an event row is not learning history.
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  userId    String?
  path      String?
  referrer  String?
  utmSource String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// One row per lifecycle email actually sent (2026-09-21), so the daily cron
// is idempotent: "finish your Diagnostic" goes once per account, the
// practice reminder at most once per day. The unique on (userId, kind, day)
// is the guarantee — a retried cron run can't double-send.
// ---------------------------------------------------------------------------

model EmailSend {
  id     String   @id @default(cuid())
  userId String
  kind   String // e.g. finish_diagnostic, daily_reminder, results
  day    String // YYYY-MM-DD (UTC); "once" for one-time kinds
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, day])
  @@map("email_sends")
}

/// One district-supplied eligible student.
///
/// This is the long-term shape of district onboarding: the district says who
/// is eligible, and a person only gets school access by matching an entry. It
/// is deliberately *not* an account — no credential is ever created or stored
/// on a student's behalf, which keeps PrepHub out of credential custody for
/// minors and keeps the data the district shares to the minimum needed to
/// answer "is this person yours?".
///
/// `schoolId` is carried per entry, which is what makes a multi-campus
/// district work: the roster names the campus, so nothing has to be guessed
/// (the domain path can't do this, and defers instead).
model SchoolRosterEntry {
  id             String @id @default(cuid())
  organizationId String // the district or standalone school that supplied it
  schoolId       String // the specific campus this student belongs to

  /// Lowercased. The identity a signing-in student is matched against.
  email             String
  /// The district's own SIS identifier, when they supply one. Never required:
  /// some districts will share an email and nothing else.
  externalStudentId String?
  /// Optional hints that save the student answering again; both are advisory.
  firstName         String?
  graduationYear    Int?

  /// Soft-removed rather than deleted, so a student taken off the roster still
  /// has a record explaining why their access ended (deletion is anonymizing,
  /// never row-removal — see CLAUDE.md).
  removedAt DateTime?

  /// When this student was last emailed an invitation to claim their district
  /// access, and how many times they have been. Recorded so a second send can
  /// skip everyone already invited: a district roster is sent in chunks to fit
  /// inside a serverless request, and without this marker the second chunk
  /// would be the same people again.
  invitedAt   DateTime?
  inviteCount Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation("RosterOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  school       Organization @relation("RosterSchool", fields: [schoolId], references: [id])

  /// One entry per email per organization. Not globally unique on email: a
  /// student who transfers between districts legitimately appears on two
  /// rosters, and "at most one active membership" is already enforced by
  /// StudentMembership.studentId being unique.
  @@unique([organizationId, email])
  @@index([email])
  @@index([organizationId, removedAt])
  /// Campus-scoped roster reads; `organizationId` is already covered as the
  /// leading column of the unique below.
  @@index([schoolId])
  @@map("school_roster_entries")
}

// ---------------------------------------------------------------------------
// Focused Practice
// ---------------------------------------------------------------------------
// The student chooses a category and a difficulty and drills it. Added
// 2026-10-17 because the only practice a student could steer was the
// Diagnostic's successor sets, which are deliberately chosen *for* them.
//
// Like the 800 Club and 1v1 Rush, these live in their own tables and are
// invisible to the adaptive engine. That isolation is the whole reason the
// feature is safe to offer: a student picking "Advanced Math, Hard" is a
// self-selected, deliberately unrepresentative sample, and PRD-014's ability
// update and PRD-016's prediction both assume the engine chose the
// questions. Letting a drill move the Predicted SAT Score would let a
// student farm Easy questions in their best category and watch a number that
// no longer means anything. Nothing in src/lib/adaptive reads these rows.
enum FocusedDifficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

enum FocusedSessionStatus {
  ACTIVE
  COMPLETED
}

model FocusedSession {
  id              String               @id @default(cuid())
  studentId       String
  category        QuestionCategory
  difficulty      FocusedDifficulty
  status          FocusedSessionStatus @default(ACTIVE)
  randomSeed      String
  currentPosition Int                  @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slots   FocusedSlot[]

  @@index([studentId, status])
  @@index([studentId, category])
  @@map("focused_sessions")
}

model FocusedSlot {
  id                 String  @id @default(cuid())
  sessionId          String
  position           Int
  questionId         String
  questionRevisionId String
  draftAnswer        String?
  skipped            Boolean @default(false)

  // Same shape as ClubSlot: the attempt lives inline because a slot is
  // answered at most once, and `finalizedAt IS NULL` inside a transaction is
  // the idempotency check.
  answer      String?
  isCorrect   Boolean?
  finalizedAt DateTime?

  session          FocusedSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id])
  questionRevision QuestionRevision @relation(fields: [questionRevisionId], references: [id])

  @@unique([sessionId, position])
  @@index([questionId])
  @@map("focused_slots")
}

/// One email waiting to be sent.
///
/// Why a queue exists at all: a district announcement or roster invitation
/// goes to thousands of addresses, and the provider's batch endpoint takes a
/// hundred per call. Twenty-odd sequential calls do not fit inside a
/// serverless request, so sending them straight from the request that
/// triggered them meant the function was killed partway through, having
/// delivered an unknowable subset with no record of which and no way to
/// retry. Rows here are written in the same transaction as the thing they
/// announce, then drained — partly by that same request, so a small school
/// still sees instant delivery, and the rest by a scheduled run.
///
/// The body is stored rather than re-derived so a drain run never has to
/// reconstruct what was meant to be said; an announcement edited or removed
/// afterwards does not silently change the mail already queued for it.
model QueuedEmail {
  id      String @id @default(cuid())
  /// Free-form label for logs and the Owner status page, e.g. "announcement".
  kind    String
  to      String
  subject String
  body    String @db.Text

  /// Taken by a drain run, so two overlapping runs can't both send this row.
  /// Cleared on failure, and treated as abandoned once older than the stale
  /// window, so a run killed mid-flight doesn't strand its claim forever.
  claimedAt DateTime?
  sentAt    DateTime?
  attempts  Int       @default(0)
  lastError String?

  createdAt DateTime @default(now())

  /// The drain query's index: unsent rows, oldest first.
  @@index([sentAt, createdAt])
  @@map("queued_emails")
}

// ---------------------------------------------------------------------------
// Account email confirmation (2026-10-24)
// ---------------------------------------------------------------------------

/// Proof that a password account controls its own email address.
///
/// Google sign-in arrives with the address already verified; a password
/// signup has only typed it. District enrollment acts on a verified address
/// only (src/lib/district/enrollment.ts), so a password signup whose email
/// matches a partner district is sent one of these, and confirming it is what
/// sets `User.emailVerified`. `email` is the address the link went to: a link
/// for an address the account no longer has proves nothing about the new one.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// Teachers, classes and homework (2026-10-24)
//
// A TEACHER account belongs to one school, runs classes there, and assigns
// homework: a fixed list of published questions. Students join a class with
// a code. The teacher sees results on the homework they assigned and nothing
// else about a student (no predicted score, no practice history), which is
// the line the join screen states to the student.
// ---------------------------------------------------------------------------

/// Which school a teacher teaches at. Created by the Owner or by that school's
/// Administrator; `removedAt` ends the teacher's access without deleting
/// their classes or anyone's work.
model TeacherAssignment {
  id        String    @id @default(cuid())
  userId    String
  schoolId  String
  createdAt DateTime  @default(now())
  removedAt DateTime?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school Organization @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId, removedAt])
  @@map("teacher_assignments")
}

model Classroom {
  id         String    @id @default(cuid())
  teacherId  String
  schoolId   String
  name       String
  /// What students type (or follow as /join/<code>) to enter the class.
  joinCode   String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  teacher     User                  @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  school      Organization          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments ClassroomEnrollment[]
  assignments Assignment[]

  @@index([teacherId, archivedAt])
  @@index([schoolId])
  @@map("classrooms")
}

model ClassroomEnrollment {
  id          String    @id @default(cuid())
  classroomId String
  studentId   String
  joinedAt    DateTime  @default(now())
  /// Removed by the teacher or left by the student. Soft, so homework the
  /// student already finished still shows in the class's results.
  removedAt   DateTime?

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@index([studentId, removedAt])
  @@map("classroom_enrollments")
}

/// Homework: a fixed list of questions assigned to one class.
model Assignment {
  id           String    @id @default(cuid())
  classroomId  String
  title        String
  instructions String?   @db.Text
  dueAt        DateTime?
  /// Closed by the teacher: nothing new can be started or answered. Work
  /// already done is kept and still counts.
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  classroom Classroom            @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  questions AssignmentQuestion[]
  sessions  HomeworkSession[]

  @@index([classroomId, createdAt])
  @@map("assignments")
}

/// One question on an assignment, pinned to the revision that was published
/// when it was assigned (the same content-stability rule as a practice set's
/// BlueprintSlot), so an Owner edit afterwards never changes what a class
/// was given.
model AssignmentQuestion {
  id                 String @id @default(cuid())
  assignmentId       String
  position           Int
  questionId         String
  questionRevisionId String

  assignment       Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id])
  questionRevision QuestionRevision @relation(fields: [questionRevisionId], references: [id])

  @@unique([assignmentId, position])
  @@index([questionId])
  @@map("assignment_questions")
}

enum HomeworkStatus {
  ACTIVE
  COMPLETED
}

/// One student's work on one assignment, created when they start it with one
/// slot per assignment question. Shaped like an 800 Club session on purpose
/// (the shared SessionRunner drives both) and, like it, invisible to the
/// adaptive engine: a teacher-chosen sample says nothing reliable about
/// ability.
model HomeworkSession {
  id              String         @id @default(cuid())
  assignmentId    String
  studentId       String
  status          HomeworkStatus @default(ACTIVE)
  currentPosition Int            @default(0)
  createdAt       DateTime       @default(now())
  completedAt     DateTime?

  assignment Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slots      HomeworkSlot[]

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
  @@map("homework_sessions")
}

model HomeworkSlot {
  id                 String  @id @default(cuid())
  sessionId          String
  position           Int
  questionId         String
  questionRevisionId String
  draftAnswer        String?
  skipped            Boolean @default(false)

  // Inline attempt, as in ClubSlot: answered at most once, and
  // `finalizedAt IS NULL` inside a transaction is the idempotency check.
  answer      String?
  isCorrect   Boolean?
  finalizedAt DateTime?

  session          HomeworkSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question         @relation(fields: [questionId], references: [id])
  questionRevision QuestionRevision @relation(fields: [questionRevisionId], references: [id])

  @@unique([sessionId, position])
  @@index([questionId])
  @@map("homework_slots")
}
